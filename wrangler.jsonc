{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sixnr-chat",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_HUB",
        "class_name": "ChatHub"
      }
    ]
  },
  "exports": {
    "ChatHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
