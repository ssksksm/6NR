{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "6nr",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "6nr-db",
      "database_id": "b5fc4e4b-905b-46dd-86af-be3fc433f8db",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_HUB",
        "class_name": "ChatHub"
      }
    ]
  },
  "exports": {
    "ChatHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
